    "package:offline": "python3 scripts/package_offline.py",
    "social:render": "node scripts/render-social.mjs",
    "logos:build": "node scripts/build-logos.mjs",
    "logos:render": "node scripts/render-logos.mjs"
  },
  "allowScripts": {
    "esbuild": false
  },
